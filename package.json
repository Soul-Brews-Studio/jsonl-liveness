{
  "name": "jsonl-liveness",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "bun test",
    "build:css": "tailwindcss -i web/theme.css -o web/style.css --minify",
    "build:web": "bun run build:css && bun build web/main.ts --target browser --outdir .local/web-build --minify --define 'process.env.NODE_ENV=\"production\"'"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}
